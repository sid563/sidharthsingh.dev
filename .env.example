# Public base URL used for metadata, sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL=https://sidharthsingh.dev
# Chat widget backend (github.com/sid563/personal-rag). Point at http://localhost:3000 to use a local copy.
NEXT_PUBLIC_CHAT_API_URL=https://chat.sidharthsingh.dev
# Cloudflare Turnstile site key (public). When set, the widget verifies the browser and gets a session from the API.
# Cloudflare's always-pass test key for local work: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Fallback when Turnstile is off: same value as CHAT_API_KEY on the API. Public in the bundle, deters scanners only.
NEXT_PUBLIC_CHAT_API_KEY=
